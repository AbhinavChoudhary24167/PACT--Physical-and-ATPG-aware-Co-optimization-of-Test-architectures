* text=auto
*.sh text eol=lf
*.py text eol=lf
*.tcl text eol=lf
*.mk text eol=lf
*.sdc text eol=lf
# Hash-bound compact research data retain exact original bytes
artifacts/** -text
artifacts/** whitespace=cr-at-eol
reports/physical_effect/** -text
reports/physical_effect/** whitespace=cr-at-eol
reports/end_to_end/** -text
reports/end_to_end/** whitespace=cr-at-eol
reports/working_solver/** -text
reports/working_solver/** whitespace=cr-at-eol
results/** -text
results/** whitespace=cr-at-eol
*.md text eol=lf
*.gz -text
reports/repository_cleanup/*.json text eol=lf
reports/repository_cleanup/*.xml text eol=lf
# Intentionally retained inputs/measurement exports are data
artifacts/raw/** linguist-generated=true
results/** linguist-generated=true
results/**/*.diff linguist-generated=false
# Collector qualification binds its LF source bytes on Windows and WSL.
/src/pact/activity/counts_vpi.cpp text eol=lf
