+#!/usr/bin/env python3
+"""Run compound-cell circuit regressions after `make install MODE=opt`."""
+import argparse
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[1]
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument('--mode', choices=('opt', 'dbg'), default='opt')
+args = parser.parse_args()
+environment = dict(os.environ, ASAN_OPTIONS='detect_leaks=0:halt_on_error=1')
+with tempfile.TemporaryDirectory(prefix='fan-compound-regression-') as directory:
+    binary = str(Path(directory) / 'compound_circuit_test')
+    command = ['g++', '-std=c++11', '-g', '-O1' if args.mode == 'dbg' else '-O3',
+               '-I' + str(root / 'include'), str(root / 'tests/compound_circuit_test.cpp'),
+               '-L' + str(root / 'lib' / args.mode), '-lcore', '-linterface', '-lcommon', '-o', binary]
+    if args.mode == 'dbg':
+        command.extend(['-fsanitize=address,undefined', '-fno-omit-frame-pointer'])
+    subprocess.run(command, check=True)
+    for test in ('depth', 'arity', 'truth'):
+        subprocess.run([binary, str(root / 'techlib/mod_nangate45.mdt'),
+                        str(root / 'tests/compound_scan.v'), test], env=environment, check=True)
+    script = Path(directory) / 'atpg.script'
+    script.write_text(f'read_lib {root}/techlib/mod_nangate45.mdt\n'
+                      f'read_netlist {root}/tests/compound_scan.v\n'
+                      'build_circuit --frame 1\nset_fault_type saf\nadd_fault --all\n'
+                      'set_static_compression on\nset_dynamic_compression on\nset_X-Fill on\n'
+                      'run_atpg\nreport_statistics\nexit\n')
+    completed = subprocess.run([str(root / 'bin' / args.mode / 'fan'), '-f', str(script)],
+                               env=environment, capture_output=True, text=True, timeout=30, check=True)
+    if '**ERROR' in completed.stdout + completed.stderr or 'Finished pattern generation' not in completed.stdout:
+        raise AssertionError(completed.stdout + completed.stderr)
+    print('compound-cell ATPG PASS')
