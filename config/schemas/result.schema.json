{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PACT Phase-0 architecture evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "design", "platform", "seed", "method", "architecture_sha256", "tool_versions", "scan", "test", "physical", "pdn", "runtime_s", "status", "evidence"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "analysis_level": {"enum": ["FIXED_PLACEMENT_PROXY", "PHYSICAL_RERUN"]},
    "design": {"type": "string", "minLength": 1},
    "platform": {"type": "string", "minLength": 1},
    "seed": {"type": "integer"},
    "method": {"type": "string", "minLength": 1},
    "architecture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tool_versions": {"type": "object", "required": ["openroad", "yosys", "fan_atpg"], "additionalProperties": {"type": ["string", "null"]}},
    "scan": {"type": "object", "required": ["num_cells", "num_chains", "total_hpwl_um", "mean_edge_um", "max_edge_um"], "properties": {"num_cells": {"type": "integer", "minimum": 1}, "num_chains": {"type": "integer", "minimum": 1}, "total_hpwl_um": {"type": "number", "minimum": 0}, "mean_edge_um": {"type": "number", "minimum": 0}, "max_edge_um": {"type": "number", "minimum": 0}}},
    "test": {"type": "object", "required": ["fault_model", "fault_coverage_pct", "pattern_count", "total_shift_toggles", "peak_simultaneous_toggles", "p99_simultaneous_toggles", "peak_local_activity"], "properties": {"fault_model": {"type": "string"}, "fault_coverage_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100}, "pattern_count": {"type": "integer", "minimum": 0}, "total_shift_toggles": {"type": "integer", "minimum": 0}, "peak_simultaneous_toggles": {"type": "integer", "minimum": 0}, "p99_simultaneous_toggles": {"type": "number", "minimum": 0}, "peak_local_activity": {"type": "number", "minimum": 0}}},
    "physical": {"type": "object", "required": ["wns_ns", "tns_ns", "congestion_metric", "drv_count", "routed_wirelength_um"], "properties": {"wns_ns": {"type": ["number", "null"]}, "tns_ns": {"type": ["number", "null"]}, "congestion_metric": {"type": ["number", "null"]}, "drv_count": {"type": ["integer", "null"]}, "routed_wirelength_um": {"type": ["number", "null"]}}},
    "pdn": {"type": "object", "required": ["classification", "worst_drop_v"], "properties": {"classification": {"enum": ["NOT_RUN", "TEST_CONDITIONED_STATIC_PDN_PROXY"]}, "worst_drop_v": {"type": ["number", "null"]}}},
    "runtime_s": {"type": "number", "minimum": 0},
    "status": {"enum": ["PASS", "FAIL", "TIMEOUT", "BLOCKED"]},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
